DATABASE_URL="postgresql://mca_user:mca_password@localhost:5432/mca_portal?schema=public"
PORT=5000
# Only this address may call the API from a browser (the React app)
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Signs login tokens. Make your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h